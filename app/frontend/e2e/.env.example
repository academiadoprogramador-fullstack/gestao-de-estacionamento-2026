# Copie para .env e substitua pelos dados de um SQL Server isolado para testes.
# Nunca use credenciais de produção nem versione o arquivo .env.
TEST_SQLSERVER_CONNECTION=
TEST_MIGRATION_SQLSERVER_CONNECTION=
TEST_VALET_PASSWORD=
TEST_CASHIER_PASSWORD=
TEST_ADMIN_PASSWORD=
# Opcional: padrão manobrista@local.example.invalid
# TEST_VALET_EMAIL=
# Opcional: padrão caixa@local.example.invalid
# TEST_CASHIER_EMAIL=
# Opcional: padrão admin@local.example.invalid
# TEST_ADMIN_EMAIL=
# Playwright rejeita bancos que não tenham nome dedicado começando com EstacionamentoE2E.
